# Copier en `.env` et adapter. Ne jamais committer de secret réel.

ENVIRONMENT=development
DEBUG=true

# --- Base de données --------------------------------------------------------
# En local (hors Docker) : localhost:55432 (5432 et 5433 sont souvent pris par une
# installation PostgreSQL native). Depuis le conteneur backend : postgres:5432.
DATABASE_URL=postgresql+psycopg://kadjane:kadjane@localhost:55432/kadjane

# --- Sécurité ---------------------------------------------------------------
# Générer une valeur unique : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-with-a-48-bytes-random-value-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Origines autorisées (Angular Admin, site web, Flutter Web)
CORS_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost:3000

# Origines supplémentaires par expression régulière. Laisser vide en
# développement : tout port de localhost est alors accepté, ce dont Flutter Web
# a besoin (son serveur choisit un port au hasard). À renseigner en recette /
# production uniquement pour un motif maîtrisé, ex. :
#   CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?kadjane\.app$
CORS_ORIGIN_REGEX=

# --- Seed de développement --------------------------------------------------
# Mot de passe des comptes de démonstration. DEV UNIQUEMENT.
SEED_PASSWORD=kadjane
