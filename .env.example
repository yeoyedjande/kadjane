# Variables consommées par docker-compose.yml. Copier en `.env`.
# Aucun secret réel ne doit être committé.

POSTGRES_USER=kadjane
POSTGRES_PASSWORD=kadjane
POSTGRES_DB=kadjane
POSTGRES_PORT=55432

BACKEND_PORT=8000
ENVIRONMENT=development

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost:3000

# Origines supplémentaires par expression régulière. Vide en développement :
# tout port de localhost est alors accepté (Flutter Web en choisit un au hasard).
CORS_ORIGIN_REGEX=

# Mot de passe des comptes de démonstration (DEV UNIQUEMENT).
SEED_PASSWORD=kadjane

# Notifications push : contenu JSON de la clé de compte de service Firebase
# (Paramètres du projet -> Comptes de service -> Générer une clé privée).
# Vide, l'envoi push est ignoré ; les notifications restent visibles dans l'app.
FIREBASE_SERVICE_ACCOUNT_JSON=
